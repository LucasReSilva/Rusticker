{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (Dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    },
    {
      "name": "Launch Edge (Dev)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    },
    {
      "name": "Debug Vitest Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/web/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Rust Tests (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--no-run", "--package", "rusticker-core"],
        "filter": {
          "name": "rusticker_core",
          "kind": "lib"
        }
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
