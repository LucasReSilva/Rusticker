{
	"name": "web",
	"private": true,
	"version": "0.2.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && bun run i18n:compile || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url baseLocale --emit-ts-declarations --silent",
		"check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"i18n:check": "bun scripts/i18n-check.ts",
		"verify:build": "bun scripts/verify-build.ts",
		"test:e2e": "playwright test",
		"lint:design": "bun scripts/lint-design.ts",
		"seo:check": "bun scripts/seo-check.ts",
		"pwa:icons": "pwa-assets-generator --preset minimal-2023 --manifest false static/icons/icon.svg",
		"changelog:preview": "git-cliff --workdir .. --unreleased",
		"version:sync": "bun scripts/sync-version.ts",
		"version:check": "bun scripts/sync-version.ts --check",
		"demo:record": "node scripts/record-demo.mjs",
		"dev:all": "bun run build:wasm && bun run dev",
		"build:wasm": "wasm-pack build ../core --target web && bun install"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.55.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24",
		"@vite-pwa/assets-generator": "^2.0.0",
		"bits-ui": "^2.18.0",
		"cn": "^0.3.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"git-cliff": "^2.14.2",
		"globals": "^17.6.0",
		"jpeg-js": "^0.4.4",
		"jsdom": "^30.1.2",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@vite-pwa/sveltekit": "^1.1.0",
		"comlink": "^4.4.2",
		"jszip": "^3.10.2",
		"rusticker-core": "file:../core/pkg",
		"workbox-window": "^7.4.1"
	}
}
